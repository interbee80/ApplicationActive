{
  "//": "ЕДИНАЯ ТОЧКА ВХОДА. Все настройки ApplicationActive задаются только здесь. Значения ниже применяются при запуске службы; параметры учёта затем можно менять из Web-панели (они хранятся в базе).",
  "//port": "Адрес и порт Web-панели задаются ТОЛЬКО в AppActive:Urls. Чтобы открыть панель с других машин, замените 127.0.0.1 на 0.0.0.0 и задайте AppActive:Security:AdminKey.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 4194304
    }
  },
  "AppActive": {
    "ServiceName": "AppActive",
    "ServiceDisplayName": "ApplicationActive — учёт активности приложений",
    "ServiceDescription": "Следит за активными приложениями во всех пользовательских сеансах Windows, ведёт базу SQLite и Web-панель с отчётами и критическим временем.",
    "DataDirectory": "%ProgramData%\\AppActive",
    "DatabaseFileName": "activity.db",
    "Urls": [
      "http://127.0.0.1:5190"
    ],
    "Security": {
      "AdminKey": "",
      "IngestKey": "",
      "AllowRemoteRead": true
    },
    "Monitoring": {
      "Enabled": true,
      "SessionScanSeconds": 10,
      "LaunchAgents": true,
      "AgentExecutable": "AppActive.Agent.exe",
      "AllowSelfSessionFallback": true,
      "AgentStaleSeconds": 180,
      "CollectWindowTitles": true,
      "Initial": {
        "PollIntervalSeconds": 5,
        "ActivityIdleSeconds": 60,
        "FlushSeconds": 15,
        "RetentionDays": 90,
        "AgentHeartbeatSeconds": 60,
        "MonitorEnabled": true,
        "CollectWindowTitles": true,
        "IgnoreProcesses": [
          "logonui.exe",
          "lockapp.exe"
        ]
      }
    },
    "Workflow": {
      "AllowScriptActions": false,
      "EvaluationSeconds": 60,
      "WebhookTimeoutSeconds": 10
    },
    "Logging": {
      "Level": "Information",
      "FileRetentionDays": 14,
      "WriteEventLog": true
    }
  }
}
