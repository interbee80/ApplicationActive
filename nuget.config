<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Офлайн-сборка: сначала локальный feed (.packages, наполняется scripts\setup-offline-packages.ps1
    из локального кэша NuGet), затем глобальный кэш пакетов. nuget.org добавлен последним,
    поэтому при наличии пакетов в кэше сеть не требуется.
  -->
  <packageSources>
    <clear />
    <add key="local-feed" value=".packages" />
    <add key="global-cache" value="%USERPROFILE%\.nuget\packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
